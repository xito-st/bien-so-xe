# CSDL PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/biensoxe_dev
TEST_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/biensoxe_test

# Mật khẩu khởi tạo của tài khoản ADMINS (FR-002, G-10)
ADMIN_INITIAL_PASSWORD=CHANGE_ME_ADMIN_INITIAL_PASSWORD

# Khóa mã hóa bí mật TOTP (32-byte url-safe base64 Fernet key, FR-019)
TOTP_ENC_KEY=CHANGE_ME_FERNET_KEY_32_BYTES_BASE64_URLSAFE=

# Khóa bí mật phiên làm việc (FR-022)
SESSION_SECRET=CHANGE_ME_SESSION_SECRET_AT_LEAST_32_CHARS

# Cấu hình nghiệp vụ và giới hạn (NFR-015, G-8)
PASSWORD_MIN_LENGTH_USER=10
PASSWORD_MIN_LENGTH_ADMIN=12
PASSWORD_HISTORY_COUNT=5
PASSWORD_EXPIRE_DAYS=90
PASSWORD_WARN_DAYS=7
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
SESSION_IDLE_TIMEOUT_MINUTES=30
IMPORT_MAX_FILE_SIZE_MB=5
IMPORT_MAX_ROWS=5000
BATCH_MAX_PLATES=5000
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST_KIB=19456
ARGON2_PARALLELISM=1
