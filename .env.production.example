# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN QUẢN LÝ BIỂN SỐ XE (.env)
# ==============================================================================

# 1. Cấu hình Tên miền hoặc IP máy chủ
# - Để trống hoặc ":80" nếu truy cập trực tiếp bằng địa chỉ IP VPS: DOMAIN_NAME=:80
# - Điền tên miền thật nếu có (Caddy sẽ TỰ ĐỘNG cấp chứng chỉ HTTPS Let's Encrypt):
DOMAIN_NAME=biensoxe.example.com

# 2. Cấu hình CSDL PostgreSQL cho Docker
POSTGRES_PASSWORD=BienSoXe@2026!ProdSecret
DATABASE_URL=postgresql+psycopg://postgres:BienSoXe@2026!ProdSecret@db:5432/biensoxe_prod

# 3. Mật khẩu khởi tạo tài khoản Cục C08 (ADMINS)
ADMIN_INITIAL_PASSWORD=AdminInit@2026!SecretKey

# 4. Khóa bí mật TOTP 2FA (Sinh bằng: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
TOTP_ENC_KEY=qW9p2eXy4zABcdEfGhIjKlMnOpQrStUvWxYz0123456=

# 5. Khóa bí mật Cookie phiên làm việc (Tối thiểu 32 ký tự ngẫu nhiên)
SESSION_SECRET=biensoxe_super_secret_session_key_production_2026_at_least_32_chars

# 6. Ngưỡng nghiệp vụ và chính sách mật khẩu (NFR-015, G-8)
PASSWORD_MIN_LENGTH_USER=10
PASSWORD_MIN_LENGTH_ADMIN=12
PASSWORD_HISTORY_COUNT=5
PASSWORD_EXPIRE_DAYS=90
PASSWORD_WARN_DAYS=7
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
SESSION_IDLE_TIMEOUT_MINUTES=30
IMPORT_MAX_FILE_SIZE_MB=5
IMPORT_MAX_ROWS=5000
BATCH_MAX_PLATES=5000

# 7. Thông số băm mật khẩu Argon2id
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST_KIB=19456
ARGON2_PARALLELISM=1
